# ATK Neptune N9 / N9 Pro / N9 Ultra udev rules
# Grant user permissions for hidraw and serial (ttyACM) endpoints

SUBSYSTEM=="hidraw", KERNEL=="hidraw*", ATTRS{idVendor}=="373b", TAG+="uaccess", MODE="0666"
SUBSYSTEM=="tty", KERNEL=="ttyACM*", ATTRS{idVendor}=="373b", ATTRS{idProduct}=="11ca", TAG+="uaccess", MODE="0666"
SUBSYSTEM=="tty", KERNEL=="ttyACM*", ATTRS{idVendor}=="373b", ATTRS{idProduct}=="11cb", TAG+="uaccess", MODE="0666"
SUBSYSTEM=="tty", KERNEL=="ttyACM*", ATTRS{idVendor}=="373b", ATTRS{idProduct}=="1203", TAG+="uaccess", MODE="0666"
SUBSYSTEM=="tty", KERNEL=="ttyACM*", ATTRS{idVendor}=="373b", ATTRS{idProduct}=="1204", TAG+="uaccess", MODE="0666"
